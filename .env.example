# ── Supabase (auth + structured metadata) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_secret

# ── AWS Aurora DSQL (chats, tasks, sites, files, revisions, leads) ─────────────
# Serverless PostgreSQL-compatible distributed SQL — the primary relational store
DSQL_ENDPOINT=<cluster-id>.dsql.us-east-1.on.aws   # from AWS Console → Aurora DSQL

# ── AWS DynamoDB (chat messages + site analytics) ───────────────────────────────
# High-throughput NoSQL — ideal for append-only messages (PK=chatId) and page-view events (PK=siteId)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxx
DYNAMODB_MESSAGES_TABLE=javis-messages     # PK=chatId  SK=createdAt#msgId
DYNAMODB_ANALYTICS_TABLE=javis-analytics  # PK=siteId  SK=createdAt#evtId

# ── LLM – Groq ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile        # optional, defaults to llama-3.3-70b-versatile

# ── Pinecone (RAG vector store) ─────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_xxx
PINECONE_INDEX=javis-rag

# ── GitHub (repo review + publish) ──────────────────────────────────────────────
GITHUB_TOKEN=github_pat_xxx               # fine-grained PAT, repo scope

# ── Scheduled automations cron ───────────────────────────────────────────────
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=your-random-secret-here

# ── Email (platform — admin only, NOT shown to end users) ─────────────────────
# Your team sets this once. Users only enter their inbox in Settings → Connections.
# Create ai@yourcompany.com in Resend with your verified domain.
RESEND_API_KEY=re_xxx
RESEND_FROM=KernelHub AI <ai@yourcompany.com>

# ── Omnichannel Messaging (WhatsApp/SMS) ──────────────────────────────────────
# Twilio Account (for SMS and WhatsApp Sandbox)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
# Meta WhatsApp Business API Verify Token (can be any string)
WHATSAPP_VERIFY_TOKEN=your-random-verify-token

# Slack: users connect via Settings → Connections (webhook stored per user in DB)

# ── LAUNCH CHECKLIST (when user says "project completed") ─────────────────────
# 1. Google Cloud Run + Cloud Scheduler → GET /api/cron/automations every minute
# 2. Resend: verify domain, switch to production API key + RESEND_FROM
# 3. Set strong CRON_SECRET in Cloud Run env (not dev default)

# ── Secrets & integration versions ─────────────────────────────────────────────
# Encrypts per-user integration credentials at rest. Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# Meta Graph API version used for Facebook/Instagram/WhatsApp calls
META_GRAPH_VERSION=v21.0
# Google Ads API version
GOOGLE_ADS_API_VERSION=v18
# upload-post.com API key (social media publishing)
UPLOAD_POST_API_KEY=
# Set to true ONLY for local development to skip Twilio webhook signature checks
TWILIO_SKIP_SIGNATURE_VERIFICATION=false

# ── App ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Phase 2: payments (Lane C) ──────────────────────────────────────────────────
# "simulated" (default, no real money moves) | "stripe" | "razorpay"
PAYMENTS_PROVIDER=simulated
# Shared secret that signs simulated-provider webhook calls (openssl rand -hex 32)
PAYMENTS_SIMULATED_SECRET=
# Stripe — only read when PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Razorpay — only read when PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Phase 2: transactional email (Lane B) ──────────────────────────────────────
# RESEND_API_KEY is shared with the platform mailer above; EMAIL_FROM is the
# sender for notifications, invites, quotes and invoices.
EMAIL_FROM=KernelHub <no-reply@yourcompany.com>

# ── Phase 2: security (Lane E) ─────────────────────────────────────────────────
# Cloudflare Turnstile bot check on signup. Leave BOTH unset to skip silently.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# CSP ships as Content-Security-Policy-Report-Only; set to 1 to enforce it.
CSP_ENFORCE=0
# Comma-separated origins allowed to call the public widget/lead/analytics
# endpoints when a site has no per-site allow-list (sites.allowed_origins).
# Unset = wildcard (*).
PUBLIC_WIDGET_ORIGINS=https://www.yourcompany.com,https://client-site.com
