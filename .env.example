# KernelHub environment — copy to .env.local and fill in.
# Every variable here is catalogued in src/lib/env/vars.json; `node scripts/check-env.mjs`
# audits your file and `/api/health?verbose=1` shows the same report at runtime.
# Lines starting with "# VAR=" are documented optional settings left unset.

# ── Required core ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Supabase → Settings → API → "service_role" secret (JWT role must be service_role,
# or the newer sb_secret_… key). Never the anon key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Aurora DSQL cluster host — or localhost / 127.0.0.1 for plain Postgres (uses DB_*).
DSQL_ENDPOINT=<cluster-id>.dsql.us-east-1.on.aws
# Bearer token for /api/cron/agents and /api/health?verbose=1 — openssl rand -hex 32
CRON_SECRET=your-random-secret-at-least-16-chars
# Signs marketing open/click/unsubscribe links (required in production) — openssl rand -hex 32
# MARKETING_TRACKING_SECRET=
# Set to the old value while rotating so already-sent links keep verifying.
# MARKETING_TRACKING_SECRET_PREVIOUS=
# Trusted reverse-proxy hops in X-Forwarded-For (default 1 on Vercel/production, 0 otherwise).
# TRUSTED_PROXY_HOPS=1
# Public origin used in emails, OAuth redirects and share links.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Encrypts per-tenant integration credentials at rest — openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# ── Database (plain Postgres mode only; ignored for Aurora DSQL) ──────────────
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=postgres
AWS_REGION=us-east-1

# ── AWS DynamoDB (chat messages + site analytics; all four or none) ───────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxx
DYNAMODB_MESSAGES_TABLE=javis-messages     # PK=chatId  SK=createdAt#msgId
DYNAMODB_ANALYTICS_TABLE=javis-analytics  # PK=siteId  SK=createdAt#evtId

# ── LLM providers (at least one) ──────────────────────────────────────────────
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile        # optional
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OPENAI_API_KEY=                          # only for social post image thumbnails
# AI_CREDIT_MARKUP=1                       # multiplier on raw LLM cost when charging credits

# ── Pinecone (RAG vector store) ───────────────────────────────────────────────
PINECONE_API_KEY=pcsk_xxx
PINECONE_INDEX=javis-rag

# ── GitHub (repo review + publish) ────────────────────────────────────────────
GITHUB_TOKEN=github_pat_xxx               # fine-grained PAT, repo scope

# ── Email ─────────────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=resend                    # resend | gmail
RESEND_API_KEY=re_xxx
RESEND_FROM=KernelHub AI <ai@yourcompany.com>
# Sender for notifications, invites, quotes and invoices.
EMAIL_FROM=KernelHub <no-reply@yourcompany.com>
# Gmail/SMTP transport when EMAIL_PROVIDER=gmail (SMTP_* are aliases).
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# SMTP_USER=
# SMTP_PASSWORD=

# ── Messaging: Twilio (SMS / WhatsApp / voice — all three or none) ────────────
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+15550000000
# TWILIO_WHATSAPP_FROM=                    # defaults to TWILIO_FROM_NUMBER
# Set to true ONLY for local development to skip Twilio webhook signature checks
TWILIO_SKIP_SIGNATURE_VERIFICATION=false
# Meta WhatsApp Business API verify token (any string)
WHATSAPP_VERIFY_TOKEN=your-random-verify-token
META_GRAPH_VERSION=v21.0
GOOGLE_ADS_API_VERSION=v18
# upload-post.com API key (social media publishing)
UPLOAD_POST_API_KEY=

# ── Payments ──────────────────────────────────────────────────────────────────
# "simulated" (default, no real money moves) | "stripe" | "razorpay"
PAYMENTS_PROVIDER=simulated
# Signs simulated-provider webhook calls (openssl rand -hex 32)
PAYMENTS_SIMULATED_SECRET=
# KernelHub plan enforcement (default false: nothing is blocked, usage still shown)
PLANS_ENFORCED=false
# Production demo deployments only: lets the simulated payment provider mark things paid (insecure for real customers)
# PAYMENTS_ALLOW_SIMULATED=false
# Stripe — required when PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Razorpay — required when PAYMENTS_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── Security ──────────────────────────────────────────────────────────────────
# Cloudflare Turnstile bot check on signup. Leave BOTH unset to skip silently.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# CSP ships as Content-Security-Policy-Report-Only; set to 1 to enforce it.
CSP_ENFORCE=0
# Comma-separated origins allowed to call the public widget/lead/analytics
# endpoints when a site has no per-site allow-list. Unset = wildcard (*).
PUBLIC_WIDGET_ORIGINS=https://www.yourcompany.com,https://client-site.com
# 1 = allow http://localhost webhook targets (development only)
# WEBHOOKS_ALLOW_INSECURE=0

# ── Mail inbox sync (Gmail + Outlook OAuth; omit to use the simulated inbox) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# MS_TENANT=common

# ── Web Push (node scripts/gen-vapid-keys.mjs) ────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@yourcompany.com
# NEXT_PUBLIC_PWA=1                        # register the service worker in dev
# NEXT_PUBLIC_VITALS_SAMPLE=0.1            # Web Vitals reporting sample rate (0..1)
# ATTACHMENTS_LOCAL_DIR=.data/attachments  # dev only: local file storage for attachments when Supabase Storage is not configured

# ── Platform flags ────────────────────────────────────────────────────────────
RATE_LIMIT_STORE=memory            # memory | db (db when running >1 instance)
SSO_ENABLED=0                      # 1 enables the SAML login button + SCIM endpoints
SSO_PROVIDER_NAME=SSO

# ── Accounting ────────────────────────────────────────────────────────────────
ACCOUNTING_PROVIDER=csv            # csv | quickbooks | xero
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox                    # sandbox | production
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# ── Developer tooling (not read by the app server) ────────────────────────────
# JAVIS_DEV_PORT=3001                      # scripts/dev.mjs
# KH_BASE_URL=http://localhost:3001       # scripts/seed-demo.mjs, scripts/smoke.mjs
# KH_API_KEY=kh_...                        # scripts/seed-demo.mjs

# Set to false once a dedicated MARKETING_TRACKING_SECRET is deployed to stop honouring CRON_SECRET-derived tracking tokens
# MARKETING_TRACKING_ACCEPT_LEGACY=true

# ── Observability & operations ────────────────────────────────────────────────
# LOG_LEVEL=info                 # debug | info | warn | error | silent
# LOG_FORMAT=json                # force JSON log lines outside production
# METRICS_TOKEN=                 # bearer for GET /api/metrics (404 when unset); openssl rand -hex 32
# OPERATOR_ORG_ID=               # operator workspace id: platform alert rules + deployment-wide queue stats
